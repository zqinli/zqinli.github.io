---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_pages = site.pages | sort: 'url' -%}
  {% for item in sitemap_pages -%}
    {% unless item.sitemap == false or item.url contains '.xml' or item.url contains '.txt' -%}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
  </url>
    {% endunless -%}
  {% endfor -%}
  {% assign sitemap_publications = site.publications | sort: 'url' -%}
  {% for publication in sitemap_publications -%}
  <url>
    <loc>{{ publication.url | absolute_url | xml_escape }}</loc>
  </url>
  {% endfor -%}
</urlset>
